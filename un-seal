#!/bin/bash

# ---
# un-seal: A helper script to initialize or unseal a Juju-deployed Vault charm.
# version: 2.2.0 (GPG/YubiKey Edition)
#
# This script automatically finds the Juju leader unit for the Vault
# charm.
#
# 1. If Vault is *not* initialized:
#    - Runs 'vault operator init'.
#    - Prompts for a GPG ID (--gpg-id) if not provided.
#    - Saves the new keys and root token to a GPG-encrypted file. (defaults to $HOME/${CHARM_NAME}_creds.gpg)
#    - Uses these new keys to unseal all units.
#
# 2. If Vault is *already* initialized:
#    - Prompts for the location of the encrypted credentials file
#      (or uses default $HOME/${CHARM_NAME}_creds.gpg).
#    - Prompts for YubiKey/GPG validation (PIN/touch) to decrypt the file.
#    - Uses the decrypted keys to unseal all units.
#
# Finally, it passes the root token to the charm via 'authorize-charm'
# on the leader unit.
#
# Made by: Pablo Gonzalez De Greiff @ Canonical
# ---

# Exit immediately if a command exits with a non-zero status.
# Treat unset variables as an error.
# The return value of a pipeline is the status of the last command to exit with a
# non-zero status, or zero if no command exited with a non-zero status.
set -euo pipefail

# --- Configuration ---
SNAP_VERSION=${SNAP_VERSION:-"2.2.0-dev"}
KEY_SHARES=3
KEY_THRESHOLD=2
CHARM_NAME="vault" # Default Juju charm name
TIMEOUT_MINUTES=10 # Default timeout for unit initialization (min)
INIT_WAIT_SLEEP=30 # 30 second poll interval
CREDS_FILE="" # Path to encrypted credentials file (defaults to $HOME/${CHARM_NAME}_creds.gpg)
GPG_ID="" # GPG Recipient ID for encryption
SEAL=false # Default: Do not invoke cute seal at the end

# --- Colors ---
# Check if stderr is a TTY
if [ -t 2 ]; then
    RED='\033[0;31m'
    YELLOW='\033[0;33m'
    GREEN='\033[0;32m'
    BLUE='\033[1;34m'
    CYAN='\033[1;36m'
    NC='\033[0m' # No Color
else
    RED=''
    YELLOW=''
    GREEN=''
    BLUE=''
    NC=''
fi

