# Function to display help message
show_help() {
    #seal
    cat << EOF
Usage: $(basename "$0") [options]
Version: $SNAP_VERSION

Initializes or unseals the Juju-deployed Vault charm using GPG/YubiKey.
This script is interactive. If Vault is already initialized, it will
prompt for YubiKey validation to decrypt the existing credential files.

This script finds the charm leader, initializes it, fetches the CA,
unseals every unit in the charm, and then passes the root token back
to the charm on the leader via 'authorize-charm'.

Options:
  -n, --charm-name <name>   (Optional) The name of the Juju Vault charm.
                                (default: "vault") Must exist in your current Juju model.
  -s, --key-shares <num>    (Optional) The number of key shares to generate.
                                (default: 3) Must be >= 1
  -t, --key-threshold <num> (Optional) The number of keys required to unseal.
                                (default: 2) Must be >= 1 and <= key-shares
  -T, --timeout <mins>      (Optional) The timeout in minutes to wait for units to initialize.
                                (default: 10) Must be >= 1
  -d, --creds-dir <path>    (Optional) Path to directory for GPG-encrypted credentials (save/load).
                                (default: $HOME/[charm-name]_creds/)
  -g, --gpg-id <id>         (Optional) The GPG Key ID or email to use for encryption.
                                (will be prompted for on init if not provided)
  -a, --skip-auth           (Optional) Force skip the charm authorization steps (5-8).
                                Useful if the charm is authorized but units are sealed.
  -S, --seal                (Easter Egg) Invoke cute Seal after success.
  -h, --help                Show this help message.

Example:
  # Initialize 'vault-ha' charm, specifying all parameters
  $(basename "$0") --charm-name vault-ha -s 3 -t 2 --creds-dir ./vault-ha-creds/ --gpg-id "my-email@example.com" -S

  # Unseal 'vault' charm using the default credentials file location with 5 shares, requiring 3 to unseal
  $(basename "$0") -s 5 -t 3

  # Initialize 'vault' charm, using defaults (will prompt for GPG ID)
  $(basename "$0")
EOF
}

# Securely overwrite and remove a file.
secure_delete() {
    local file="$1"
    if [ -f "$file" ]; then
        # Check if shred is available
        if command -v shred >/dev/null 2>&1; then
            shred -u -z -n 1 "$file"
            echo "Temporary file '$file' shredded."
        else
            # Fallback to rm if shred is missing
            rm -f "$file"
            echo "Temporary file '$file' deleted."
        fi
    fi
}

# Cleanup function to remove temporary files on EXIT.
cleanup() {
    if [ -n "${VAULT_CERT_FILE:-}" ] && [ -f "$VAULT_CERT_FILE" ]; then
        secure_delete "$VAULT_CERT_FILE"
    fi
}

# Function to check script parameters for validity.
check_params() {
    local int_regex='^[0-9]+$'
    local error_found=0

    # 1. Check CHARM_NAME.
    if [ -z "$CHARM_NAME" ]; then
        echo -e "${BRED}Error:${NC} charm name (--charm-name) cannot be empty." >&2
        error_found=1
    fi

    # 2. Check KEY_SHARES.
    if ! [[ "$KEY_SHARES" =~ $int_regex ]] || [ "$KEY_SHARES" -lt 1 ]; then
        echo -e "${BRED}Error:${NC} Key shares (--key-shares) must be an integer >= 1. (Got: '$KEY_SHARES')" >&2
        error_found=1
    fi

    # 3. Check KEY_THRESHOLD.
    if ! [[ "$KEY_THRESHOLD" =~ $int_regex ]] || [ "$KEY_THRESHOLD" -lt 1 ]; then
        echo -e "${BRED}Error:${NC} Key threshold (--key-threshold) must be an integer >= 1. (Got: '$KEY_THRESHOLD')" >&2
        error_found=1
    fi

    # 4. Check relationship between SHARES and THRESHOLD.
    # Only check this if both values were valid integers.
    if [[ "$KEY_SHARES" =~ $int_regex ]] && [[ "$KEY_THRESHOLD" =~ $int_regex ]]; then
        if [ "$KEY_THRESHOLD" -gt "$KEY_SHARES" ]; then
            echo -e "${BRED}Error:${NC} Key threshold ($KEY_THRESHOLD) cannot be greater than key shares ($KEY_SHARES)." >&2
            error_found=1
        fi
    fi

    # 5. Check TIMEOUT_MINUTES.
    if ! [[ "$TIMEOUT_MINUTES" =~ $int_regex ]] || [ "$TIMEOUT_MINUTES" -lt 1 ]; then
        echo -e "${BRED}Error:${NC} Timeout (--timeout) must be an integer in minutes >= 1. (Got: '$TIMEOUT_MINUTES')" >&2
        error_found=1
    fi
    
    if [ "$error_found" -eq 1 ]; then
        echo ""
        show_help
        exit 1
    fi
}

# Function to check for required command-line tools.
check_deps() {
    local missing_deps=0
    
    echo "  Checking dependencies..."
    
    local juju_version_string
    local juju_major_version

    if ! juju_version_string=$(juju --version 2>/dev/null); then
        echo -e "${BRED}Error:${NC} 'juju' command not found or not functional." >&2
        missing_deps=1
    else
        # Juju exists, let's check the version and set commands
        juju_major_version=$(echo "$juju_version_string" | cut -d. -f1)

        if ! [[ "$juju_major_version" =~ ^[0-9]+$ ]]; then
            echo -e "${BRED}Error:${NC} Could not parse Juju version: '$juju_version_string'" >&2
            missing_deps=1
        elif [ "$juju_major_version" -lt 3 ]; then
            echo -e "  Juju 2.9.x ($juju_version_string) detected. ${BYELLOW}Using legacy 'run-action' command.${NC}"
            JUJU_RUN="run-action"
            JUJU_EXEC="run"
        else
            echo -e "  Juju 3.x+ ($juju_version_string) detected. Using modern 'run' command."
            JUJU_RUN="run"
            JUJU_EXEC="exec"
        fi
    fi
    
    if ! jq --version > /dev/null 2>&1; then
        echo -e "${BRED}Error:${NC} 'jq' command not found or not functional." >&2
        missing_deps=1
    fi
    
    if ! vault -version > /dev/null 2>&1; then
        echo -e "${BRED}Error:${NC} 'vault' command not found or not functional." >&2
        missing_deps=1
    fi

    if ! gpg --version > /dev/null 2>&1; then
        echo -e "${BRED}Error:${NC} 'gpg' command not found or not functional." >&2
        echo "       'gpg' is required for YubiKey encryption/decryption." >&2
        missing_deps=1
    fi

    if [ "$missing_deps" -eq 1 ]; then
        exit 1
    fi

    echo "  All dependencies found."

    # Verify the charm name exists in the current Juju model.
    echo -e "  Verifying Juju charm ${BGREEN}'$CHARM_NAME'${NC} exists..."

    if ! juju status --format=json | jq -e --arg charm "$CHARM_NAME" '.applications | has($charm)' > /dev/null 2>&1; then
        echo -e "${BRED}Error:${NC} Juju charm ${BRED}'$CHARM_NAME'${NC} not found in the current model." >&2
        echo "       Please check the charm name and your current Juju model." >&2
        exit 1
    fi

    echo "    ...charm found."
    echo ""
}

# Check Unit Health (MySQL and Restart Logic) - check_and_heal_unit(unit_name)
check_and_heal_unit() {
    local unit_name="$1"
    local unit_data
    local subs
    local vault_status
    local vault_message
    local router_status=""
    local router_message=""
    
    # Extract status for this specific unit from the global JSON.
    unit_data=$(jq -r --arg charm "$CHARM_NAME" --arg unit "$unit_name" '.applications[$charm].units[$unit]' <<< "$VAULT_STATUS_JSON")
    
    vault_status=$(jq -r '."workload-status".current' <<< "$unit_data")
    vault_message=$(jq -r '."workload-status".message' <<< "$unit_data")

    # Iterate subordinates to find mysql-router.
    subs=$(jq -r '.subordinates // {} | to_entries[] | select(.key | contains("mysql-router")) | .value' <<< "$unit_data" 2>/dev/null || echo "")
    if [ -n "$subs" ]; then
        router_status=$(jq -r '."workload-status".current' <<< "$subs")
        router_message=$(jq -r '."workload-status".message' <<< "$subs")
    fi

    # Check MySQL Router Blockage.
    if [[ "$router_status" == "blocked" ]] && [[ "$router_message" == *"Failed to connect"* ]]; then
        echo -e "${BRED}Error:${NC} $unit_name mysql-router is blocked: $router_message"
        echo "       Vault cannot start without the database connection."
        echo "       Please fix the MySQL integration before attempting to unseal."
        exit 1
    fi

    # Restart service if vault is error/hook failed, but router is not blocked (or doesn't exist)
    if ( [[ "$vault_status" == "error" ]] && [[ "$vault_message" == *"hook failed"* ]] ) || ( [[ "$vault_status" == "blocked" ]] && [[ "$vault_message" == *"service not running"* ]] ); then
        echo ""
        echo -e "  Detected ${BYELLOW}stuck${NC} state on $unit_name (hook failed: start)."
        echo -e "  Database connection appears OK (or N/A). Attempting to restart vault service..."
        
        # Run systemctl restart via Juju
        if juju $JUJU_EXEC --unit "$unit_name" -- sudo systemctl restart vault; then
            for (( attempt=1; attempt<=$MAX_WAIT_ATTEMPTS; attempt++ )); do
                # Check service via exec
                if juju $JUJU_EXEC --unit "$unit_name" -- systemctl is-active vault >/dev/null 2>&1; then
                    printf "\r  ${BGREEN}Service restarted.${NC}"
                    echo ""
                    return 0 # Success
                fi
                
                printf "\r  Waiting for service to start... (attempt $attempt/$MAX_WAIT_ATTEMPTS)"
                sleep $INIT_WAIT_SLEEP
            done
            
            printf "\n"
            echo -e "  ${BYELLOW}Warning:${NC} Unit '$unit_name' vault service did not restart after $MAX_WAIT_ATTEMPTS attempts." >&2
            echo ""
            return 1 # Failure
        else
            echo -e "${BRED}Error:${NC} Failed to restart service on $unit_name."
            echo ""
            return 1 # Failure
        fi
    fi
}

# Function to decrypt a single file - decrypt_file(file_path)
decrypt_file() {
    local file_path="$1"
    
    # Clear the global var
    DECRYPTED_FILE_CONTENT=""

    echo "  Decrypting '$file_path'..."
    echo "  Please validate with your GPG key (YubiKey PIN/touch may be required)..."

    # Check if path exists.
    if [ ! -f "$file_path" ]; then
        echo -e "${BRED}Error:${NC} File not found: $file_path" >&2
        echo ""
        return 1 # Failure
    fi
    
    # Decrypt the file.
    if ! DECRYPTED_FILE_CONTENT=$(gpg -q -d "$file_path"); then
        echo -e "${BRED}Error:${NC} Failed to decrypt: $file_path" >&2
        echo "       Did you enter the correct PIN? Is the YubiKey plugged in?" >&2
        echo ""
        return 1 # Failure
    fi
    
    # Check if file is empty.
    if [ -z "$DECRYPTED_FILE_CONTENT" ]; then
        echo -e "${BRED}Error:${NC} Decrypted file is empty: $file_path" >&2
        echo ""
        return 1 # Failure
    fi
    
    echo -e "    ...'$file_path' successfully ${BGREEN}decrypted${NC}."
    echo ""
    return 0 # Success
}

# Saves token and keys to separate encrypted files - save_credentials_gpg(json_data)
save_credentials_gpg() {
    local json_data="$1"
    local token
    local keys
    
    echo "  Saving new credentials to GPG-encrypted files in: $CREDS_DIR/"
    
    # Parse token and keys
    token=$(jq -r '.root_token' <<< "$json_data")
    readarray -t keys < <(jq -r '.unseal_keys_b64[]' <<< "$json_data")

    # Save Token
    local token_file="$CREDS_DIR/${CHARM_NAME}_token.gpg"
    echo "  - Encrypting token -> $token_file"
    if ! gpg --quiet --yes -e -r "$GPG_ID" -o "$token_file" <<< "$token"; then
        echo -e "${BRED}Error:${NC} Failed to encrypt token." >&2
        echo "       Check if the GPG ID '$GPG_ID' is valid and your gpg-agent is running." >&2
        echo ""
        return 1 # Failure
    fi
    chmod 600 "$token_file"

    # Save Keys
    for i in "${!keys[@]}"; do
        local key_file="$CREDS_DIR/${CHARM_NAME}_key$((i+1)).gpg"
        echo "  - Encrypting key $((i+1)) -> $key_file"
        if ! gpg --quiet --yes -e -r "$GPG_ID" -o "$key_file" <<< "${keys[$i]}"; then
            echo -e "${BRED}Error:${NC} Failed to encrypt key $((i+1))." >&2
            echo "       Check if the GPG ID '$GPG_ID' is valid and your gpg-agent is running." >&2
            echo ""
            return 1 # Failure
        fi
        chmod 600 "$key_file"
    done
    
    echo -e "${BCYAN}---${NC}"
    echo -e "  ${BGREEN}IMPORTANT:${NC}"
    echo -e "  New credentials have been ${BGREEN}GPG-ENCRYPTED${NC} and saved to $CREDS_DIR/"
    echo "  Please back up this directory and distribute files securely."
    echo -e "${BCYAN}---${NC}"
    echo ""
    return 0 # Success
}

# Tries auto-load credentials, falls back to manual file prompt, and then to raw prompt - load_credentials_gpg(required_keys, token_required)
load_credentials_gpg() {
    local required_keys="$1"
    local token_required="$2" # "true" or "false"
    local keys_ok=false
    local token_ok=false

    # These globals will be populated cumulatively.
    VAULT_TOKEN=""
    UNSEAL_KEYS=()

    echo -e "${BCYAN}---${NC}"
    echo "  Searching credentials in: $CREDS_DIR/"
    echo -e "  Required keys to find: ${BGREEN}$required_keys${NC}"
    echo ""
    
    # Try to auto-load token from default path (if required).
    if [ "$token_required" == "true" ]; then
        local auto_token_path="$CREDS_DIR/${CHARM_NAME}_token.gpg"   
        if [ -f "$auto_token_path" ]; then
            echo "  - Found token $auto_token_path..."
            echo ""
            if decrypt_file "$auto_token_path"; then
                VAULT_TOKEN="$DECRYPTED_FILE_CONTENT"
            else
                VAULT_TOKEN=""
            fi
        fi
    fi

    # Try auto-load keys (glob search for ${CHARM_NAME}_key*.gpg) from default path.
    for key_path in "$CREDS_DIR/${CHARM_NAME}_key"*.gpg; do
        if [ -f "$key_path" ]; then
            echo "  - Found key $key_path..."
            echo ""

            if decrypt_file "$key_path"; then
                if [ -n "$DECRYPTED_FILE_CONTENT" ]; then
                    UNSEAL_KEYS+=("$DECRYPTED_FILE_CONTENT")
                fi
            fi
            
            if [ ${#UNSEAL_KEYS[@]} -ge "$required_keys" ]; then
                echo -e "  Reached required number of keys: ${BGREEN}$required_keys${NC}"
                echo ""
                break
            fi
        fi
    done

    if [ ${#UNSEAL_KEYS[@]} -gt 0 ] && [ ${#UNSEAL_KEYS[@]} -lt "$required_keys" ]; then
          echo -e "  ${BYELLOW}Not reached required number of keys, found: ${#UNSEAL_KEYS[@]}${NC}"
          echo ""
    fi

    # Check if auto-load was successful.
    [ ${#UNSEAL_KEYS[@]} -ge "$required_keys" ] && keys_ok=true
    ( [ "$token_required" == "false" ] || ( [ "$token_required" == "true" ] && [ -n "$VAULT_TOKEN" ] ) ) && token_ok=true
    if [ "$keys_ok" == "true" ] && [ "$token_ok" == "true" ]; then
        echo -e "  ${BGREEN}Auto-load successful. Loaded ${#UNSEAL_KEYS[@]} keys.${NC}"
        echo ""
        return 0 # Success
    fi
     
    # Fallback to manual path prompt if auto-load failed or was partial.
    echo -e "${BCYAN}---${NC}"
    echo -e "  ${BYELLOW}Auto-load failed, or was partial. Falling back to manual path prompt...${NC}"
    echo ""

    # Check if token was found, if not prompt for path.
    if [ "$token_required" == "true" ] && [ -z "$VAULT_TOKEN" ]; then
        read -e -p "  Enter path to encrypted root token file: " token_path
        token_path=$(eval echo "$token_path")
        echo ""

        if decrypt_file "$token_path"; then
            VAULT_TOKEN="$DECRYPTED_FILE_CONTENT"
        else
            VAULT_TOKEN=""
        fi
    fi
    
    # Ask for the *remaining* number of key paths.
    local remaining_keys=$(( required_keys - ${#UNSEAL_KEYS[@]} ))
    if [ "$remaining_keys" -gt 0 ]; then
        echo "  Auto-load found ${#UNSEAL_KEYS[@]} keys. Manually prompting for $remaining_keys more file paths."
        for (( i=1; i<=$remaining_keys; i++ )); do
            read -e -p "  Enter path to additional Unseal Key $i (of $remaining_keys): " key_path
            key_path=$(eval echo "$key_path")
            echo ""

            if decrypt_file "$key_path"; then
                if [ -n "$DECRYPTED_FILE_CONTENT" ]; then
                    UNSEAL_KEYS+=("$DECRYPTED_FILE_CONTENT")
                fi
            fi

            if [ ${#UNSEAL_KEYS[@]} -ge "$required_keys" ]; then
                echo -e "  Reached required number of keys: ${BGREEN}$required_keys${NC}"
                echo ""
                break
            fi
        done
    fi

    # Check if path-load was successful.
    [ ${#UNSEAL_KEYS[@]} -ge "$required_keys" ] && keys_ok=true
    ( [ "$token_required" == "false" ] || ( [ "$token_required" == "true" ] && [ -n "$VAULT_TOKEN" ] ) ) && token_ok=true
    if [ "$keys_ok" == "true" ] && [ "$token_ok" == "true" ]; then
        echo -e "  ${BGREEN}Credentials successfully loaded via file paths.${NC}"
        echo ""
        return 0 # Success
    fi

    # Fallback to manual raw prompt if path-load failed or was partial.
    echo -e "${BCYAN}---${NC}"
    echo -e "  ${BYELLOW}Path-load failed, or was partial. Falling back to raw credential entry...${NC}"
    echo ""

    # Check if token was found, if not prompt for raw token.
    if [ "$token_required" == "true" ] && [ -z "$VAULT_TOKEN" ]; then
        read -sp "  Please enter the '$CHARM_NAME' Token: " VAULT_TOKEN
        echo ""
    fi

    # Ask for the *remaining* number of raw keys.
    remaining_keys=$(( required_keys - ${#UNSEAL_KEYS[@]} ))
    if [ "$remaining_keys" -gt 0 ]; then
        echo "  Found ${#UNSEAL_KEYS[@]} keys. Manually prompting for $remaining_keys more raw keys."
        for (( i=1; i<=$remaining_keys; i++ )); do
            local key_input
            read -sp "  Please enter Unseal Key $i (of $remaining_keys): " key_input
            echo ""

            if [ -n "$key_input" ]; then
                UNSEAL_KEYS+=("$key_input")
            fi
        done
    fi

    # Final validation.
    if ( [ "$token_required" == "true" ] && [ -z "$VAULT_TOKEN" ] ) || [ ${#UNSEAL_KEYS[@]} -lt "$required_keys" ]; then
        echo -e "${BRED}Error: Failed to load all required credentials.${NC}" >&2
        if [ "$token_required" == "true" ]; then
            echo "        - Token Loaded: $([ -n "$VAULT_TOKEN" ] && echo -e "${BGREEN}Yes${NC}" || echo -e "${BRED}No${NC}")" >&2
        fi
        echo "        - Keys Loaded:  ${#UNSEAL_KEYS[@]} / $required_keys" >&2
        echo ""
        return 1 # Failure
    fi

    echo -e "  ${BGREEN}Credentials successfully decrypted and loaded.${NC}"
    echo ""
    return 0 # Success
}

# Function to handle all unseal logic - unseal_unit(unit_name, unit_addr)
unseal_unit() {
    local unit_name="$1"
    local unit_addr="$2"
    local status_json=""
    local unseal_status=""
    local verify_status=""
    local initialized=false
    local unsealed=false
    
    if [ "$LEGACY_VAULT" == "true" ]; then
        export VAULT_ADDR="http://$unit_addr:8200"
    else
        export VAULT_ADDR="https://$unit_addr:8200"
    fi
    
    echo -e "${BCYAN}---${NC}"
    echo "  Targeting unit '$unit_name' at $VAULT_ADDR"

    # 1. Wait for the unit to be initialized.
    echo "    Waiting for unit to report as initialized..."
    for (( attempt=1; attempt<=$MAX_WAIT_ATTEMPTS; attempt++ )); do
        status_json=$(vault status -format=json 2>/dev/null || true)
        if [ -n "$status_json" ] && [ "$(jq -r '.initialized' <<< "$status_json")" == "true" ]; then
            printf "\r    Unit is ${BGREEN}initialized${NC}.                          \n"
            initialized=true
            break
        fi
        printf "\r    Waiting for unit to report as initialized... (attempt $attempt/$MAX_WAIT_ATTEMPTS)"
        sleep $INIT_WAIT_SLEEP
    done

    # Check if unit initialized.
    if [ "$initialized" == "false" ]; then
        printf "\n"
        echo -e "  ${BYELLOW}Warning:${NC} Unit '$unit_name' did not initialize after $MAX_WAIT_ATTEMPTS attempts. Skipping." >&2
        return 1 # Failure
    fi

    # 2. Check if already unsealed.
    if [ "$(jq -r '.sealed' <<< "$status_json")" != "true" ]; then
        echo -e "    Unit '$unit_name' is already ${BGREEN}unsealed${NC}. Skipping."
        return 0 # Success
    fi

    # 3. Unit is initialized but sealed, submit the correct number of keys.
    for (( i=0; i<$KEY_THRESHOLD; i++ )); do
        echo "    Submitting Unseal Key $((i+1)) to '$unit_name'..."
        unseal_status=$(vault operator unseal -format=json "${UNSEAL_KEYS[$i]}")
        
        # Check for errors.
        if ! jq -e . > /dev/null 2>&1 <<< "$unseal_status"; then
            echo -e "  ${BYELLOW}Warning:${NC} 'vault operator unseal' failed. Output was not valid JSON." >&2
            echo "           This could mean the key you entered was incorrect." >&2
            echo "Raw output: $unseal_status" >&2
            return 1 # Failure
        fi
        
        # Check if unsealed. If we get it, break early.
        if jq -r '.sealed' <<< "$unseal_status" | grep -q 'false'; then
            break
        fi

        # Print progress if it's not the final key.
        progress=$(jq -r '.progress' <<< "$unseal_status")
        total=$(jq -r '.t' <<< "$unseal_status")
        if [[ "$progress" != "null" ]] && [[ "$total" != "null" ]] && [[ "$progress" -gt 0 ]]; then
            echo "    Progress: $progress / $total"
        fi
    done

    # 4. Verify the unseal.
    echo "    Verifying unseal status..."
    for (( attempt=1; attempt<=$MAX_WAIT_ATTEMPTS; attempt++ )); do
        verify_status=$(vault status -format=json 2>/dev/null || true)
        if jq -r '.sealed' <<< "$verify_status" | grep -q 'false'; then
            printf "\r    Unit '$unit_name' is now ${BGREEN}unsealed.${NC}          \n"
            unsealed=true
            break
        fi
        printf "\r    Verifying unseal status... (attempt $attempt/$MAX_WAIT_ATTEMPTS)"
        sleep 3
    done
    
    # Failure.
    if [ "$unsealed" == "false" ]; then
        printf "\n"
        echo -e "  ${BYELLOW}Warning:${NC} Failed to verify unseal for unit '$unit_name' after submitting keys." >&2
        echo "           Please check the unit's logs or if keys are correct." >&2
        return 1 # Failure.
    fi
    
    return 0 # Success.
}

# --- Argument Parsing ---

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--charm-name)
            CHARM_NAME="$2"
            shift 2
            ;;
        -s|--key-shares)
            KEY_SHARES="$2"
            shift 2
            ;;
        -t|--key-threshold)
            KEY_THRESHOLD="$2"
            shift 2
            ;;
        -T|--timeout)
            TIMEOUT_MINUTES="$2"
            shift 2
            ;;
        -d|--creds-dir)
            CREDS_DIR="$2"
            shift 2
            ;;
        -g|--gpg-id)
            GPG_ID="$2"
            shift 2
            ;;
        -a|--skip-auth)
            SKIP_AUTH=true
            shift 1
            ;;
        -S|--seal)
            SEAL=true
            shift 1
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo -e "${BRED}Error:${NC} Unknown option: $1" >&2
            show_help
            exit 1
            ;;
        *)
            echo -e "${BRED}Error:${NC} This script does not accept positional arguments." >&2
            show_help
            exit 1
            ;;
    esac
done

# --- Main Script Logic ---

echo ""
echo -e "${BCYAN}-> un-seal version: $SNAP_VERSION${NC}"
echo ""

# Validate parameters *before* doing anything else.
check_params

# Check dependencies.
check_deps

# Set up trap for file cleanup.
trap cleanup EXIT

# Set default CREDS_DIR if not provided.
if [ -z "$CREDS_DIR" ]; then
    CREDS_DIR="${HOME}/${CHARM_NAME}_creds"
    echo -e "  ${BYELLOW}--creds-dir not specified, using default: $CREDS_DIR/ ${NC}"
fi
CREDS_DIR=${CREDS_DIR%/} # Remove trailing slash if present.

# Create directory.
if ! mkdir -p "$CREDS_DIR"; then
    echo -e "${BRED}Error:${NC} Could not create directory: $CREDS_DIR/" >&2
    echo ""
    exit 1
fi
chmod 700 "$CREDS_DIR"

# Use a predictable file for the CA.
VAULT_CERT_FILE="${CREDS_DIR}/${CHARM_NAME}_ca.pem"

# Calculate polling parameters from timeout.
MAX_WAIT_ATTEMPTS=$((TIMEOUT_MINUTES * 60 / INIT_WAIT_SLEEP))
echo "  Unit initialization timeout set to $TIMEOUT_MINUTES minutes ($MAX_WAIT_ATTEMPTS checks, $INIT_WAIT_SLEEP sec interval)."

# We need an associative array to map unit names to their addresses.
# This requires Bash 4+.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo -e "${BRED}Error:${NC} This script requires Bash 4.0 or newer." >&2
    exit 1
fi
declare -A UNIT_ADDRESSES

echo ""
echo -e "  Starting ${BCYAN}un-seal${NC} process for Juju charm: ${BGREEN}$CHARM_NAME${NC}"
echo -e "  Shares:       ${BGREEN}$KEY_SHARES${NC}"
echo -e "  Threshold:    ${BGREEN}$KEY_THRESHOLD${NC}"
echo -e "  Creds dir:    $CREDS_DIR/"
[ -n "$GPG_ID" ] && echo "  GPG ID:       $GPG_ID (will be used for init)"
echo ""

# 1. Find Vault units and leader.
echo -e "${BCYAN}-> 1.${NC} Finding Vault units and leader for charm '$CHARM_NAME'..."
VAULT_STATUS_JSON=$(juju status --format=json)
LEADER_UNIT_NAME=""

echo ""
echo "  Parsing unit information..."

# Check vault charm version.
VAULT_CHANNEL=$(jq -r --arg charm "$CHARM_NAME" '.applications[$charm]["charm-channel"] // ""' <<< "$VAULT_STATUS_JSON")
# Extract the track (the number part before the slash), e.g., "1.16" from "1.16/stable"
VAULT_TRACK=$(echo "$VAULT_CHANNEL" | cut -d'/' -f1)
echo -e "  Detected Vault Version: ${BGREEN}${VAULT_CHANNEL:-"Unknown"}${NC} (Track: ${VAULT_TRACK})"

if [[ -z "$VAULT_TRACK" ]] || [[ "$VAULT_TRACK" == "latest" ]]; then
    LEGACY_VAULT=false
    echo "  No specific version track detected (or 'latest'). Assuming Modern Vault (> 1.8)."
else
    # Check if the track is <= 1.8
    if [ "$(printf '%s\n' "1.9" "$VAULT_TRACK" | sort -V | head -n1)" == "$VAULT_TRACK" ] && [ "$VAULT_TRACK" != "1.9" ]; then
        LEGACY_VAULT=true
        echo -e "  ${BYELLOW}Legacy Vault detected (Track <= 1.8). Adjusting behavior.${NC}"
    else
        LEGACY_VAULT=false
        echo "  Modern Vault detected (Track > 1.8)."
    fi
fi

while IFS=" " read -r unit_name public_address is_leader; do
    if [ -n "$unit_name" ] && [ -n "$public_address" ] && [ "$public_address" != "null" ]; then
        UNIT_ADDRESSES["$unit_name"]="$public_address"
        if [ "$is_leader" == "true" ]; then
            LEADER_UNIT_NAME="$unit_name"
        fi
        
        # Check and heal possible vault restart errors (Arif Ali suggestion)
        check_and_heal_unit "$unit_name"
    fi
done < <(jq -r --arg charm "$CHARM_NAME" '.applications[$charm].units | to_entries[] | "\(.key) \(.value."public-address") \(.value.leader)"' <<< "$VAULT_STATUS_JSON")

if [ ${#UNIT_ADDRESSES[@]} -eq 0 ]; then
    echo -e "${BRED}Error:${NC} Found no units with public addresses for charm '$CHARM_NAME'." >&2
    exit 1
fi
echo -e "  Found ${BGREEN}${#UNIT_ADDRESSES[@]}${NC} unit(s): ${!UNIT_ADDRESSES[*]}"

if [ -z "$LEADER_UNIT_NAME" ]; then
    echo -e "${BRED}Error:${NC} Could not find leader unit for charm '$CHARM_NAME'." >&2
    echo "       Is the charm name correct and has it settled?" >&2
    exit 1
fi
echo -e "  Juju '$CHARM_NAME' leader unit is: ${BGREEN}$LEADER_UNIT_NAME${NC}"

# Set VAULT_ADDR to the leader's address for initialization.
LEADER_PUBLIC_ADDR=${UNIT_ADDRESSES["$LEADER_UNIT_NAME"]}
if [ -z "$LEADER_PUBLIC_ADDR" ]; then
    echo -e "${BRED}Error:${NC} Could not find public-address for leader unit '$LEADER_UNIT_NAME'." >&2
    exit 1
fi

if [ "$LEGACY_VAULT" == "true" ]; then
    export VAULT_ADDR="http://$LEADER_PUBLIC_ADDR:8200"
else
    export VAULT_ADDR="https://$LEADER_PUBLIC_ADDR:8200"
fi

echo -e "  Leader VAULT_ADDR set to: $VAULT_ADDR (for init)"
echo ""

# 2. Fetch Juju secret for Vault CA certificate or skip it if legacy
if [ "$LEGACY_VAULT" == "true" ]; then
  # Legacy mode
  echo -e "${BCYAN}-> 2.${NC} Legacy Vault detected. Skipping Juju secret CA fetch and VAULT_CAPATH setup."
else
  # Modern mode
  echo -e "${BCYAN}-> 2.${NC} Fetching Vault CA certificate..."
  echo ""
  CERT_SECRET_ID=$(juju secrets --format=json | jq -r 'to_entries[] | select(.value.label == "self-signed-vault-ca-certificate") | .key')

  if [ -z "$CERT_SECRET_ID" ] || [ "$CERT_SECRET_ID" == "null" ]; then
      echo -e "${BRED}Error:${NC} Could not find Juju secret with label 'self-signed-vault-ca-certificate'." >&2
      exit 1
  fi

  juju show-secret "$CERT_SECRET_ID" --reveal --format=json | jq -r '.[].content.Data.certificate' > "$VAULT_CERT_FILE"
  echo "  Created temporary CA file: $VAULT_CERT_FILE"

  export VAULT_CAPATH="$VAULT_CERT_FILE"
  echo "  VAULT_CAPATH set to temporary file: $VAULT_CAPATH"
fi

echo ""

# 3. Initialize Vault.
echo -e "${BCYAN}-> 3.${NC} Initializing Vault (targeting leader $LEADER_UNIT_NAME)..."
echo ""
# We use -format=json for reliable parsing.
init_output_and_errors=$(vault operator init -key-shares="$KEY_SHARES" -key-threshold="$KEY_THRESHOLD" -format=json 2>&1 || true)

# Declare keys and token vars.
UNSEAL_KEYS=()
VAULT_TOKEN=""

# First, check for the specific "already initialized" error.
if grep -q "Vault is already initialized" <<< "$init_output_and_errors"; then

    echo -e "  ${BGREEN}Vault is already initialized. Loading credentials from encrypted file.${NC}"

    # Check if charm is already authorized.
    token_required="true"
    leader_workload_status=$(jq -r --arg charm "$CHARM_NAME" --arg leader "$LEADER_UNIT_NAME" '.applications[$charm].units[$leader]."workload-status".current' <<< "$VAULT_STATUS_JSON")
    
    if [ "$SKIP_AUTH" == "true" ]; then
        echo -e "  ${BGREEN}Manual --skip-auth flag detected. Skipping token requirement...${NC}"
        CHARM_ALREADY_AUTHORIZED=true
        token_required="false"
    elif [ "$leader_workload_status" == "active" ]; then
        echo -e "  ${BGREEN}Leader unit workload status is 'active'. Assuming charm is authorized...${NC}"
        CHARM_ALREADY_AUTHORIZED=true
        token_required="false"
    else
        echo -e "  ${BYELLOW}Charm may not be yet authorized. (Status: '$leader_workload_status'). Token will be required.${NC}"
    fi
    echo ""
    
    # Get the required threshold from status to inform the user.
    status_json=$(vault status -format=json 2>/dev/null || true)

    # Check loaded keys against actual threshold.
    actual_threshold=$(jq -r '.t' <<< "$status_json")
    
    if ! [[ "$actual_threshold" =~ ^[0-9]+$ ]]; then
        echo -e "${BRED}Error:${NC} Could not determine actual key threshold from 'vault status'." >&2
        exit 1
    fi
    
    echo -e "  Vault status shows a key threshold of ${BGREEN}$actual_threshold${NC}."

    # Load credentials using three layered approach, if not, exit.
    if ! load_credentials_gpg "$actual_threshold" "$token_required"; then
        exit 1
    fi

    # This ensures unseal_unit submits the correct number of keys.
    KEY_THRESHOLD=$actual_threshold
    echo -e "  Key threshold for unseal operation set to ${BGREEN}$KEY_THRESHOLD${NC}."
    echo ""

else
    # Vault is NOT initialized. Check for other errors.
    # We redirect jq's stderr to /dev/null to silence "parse error" messages.
    init_output=$(jq -e . 2> /dev/null <<< "$init_output_and_errors")

    if [ -z "$init_output" ]; then
        # It failed JSON parsing *and* wasn't the "already initialized" error.
        echo -e "${BRED}Error:${NC} 'vault operator init' failed. Output was not valid JSON." >&2
        echo "Raw output:" >&2
        echo "$init_output_and_errors" >&2
        exit 1
    fi

    echo -e "  ${BGREEN}Vault Initialized Successfully.${NC}"
    echo ""
    
    # Parse JSON output.
    UNSEAL_KEYS=($(jq -r '.unseal_keys_b64[]' <<< "$init_output"))
    VAULT_TOKEN=$(jq -r '.root_token' <<< "$init_output")

    # Prompt for GPG_ID if not provided.
    if [ -z "$GPG_ID" ]; then
        echo "  Vault is newly initialized, but no GPG ID was provided."
        echo ""
        while [ -z "$GPG_ID" ]; do
            read -p "  Please enter the GPG Key ID or email for encryption: " GPG_ID >&2
        done
        echo ""
    fi
    
    if ! save_credentials_gpg "$init_output"; then
        echo -e "${BRED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}" >&2
        echo -e "${BRED}  Error: Could not save encrypted credentials to '$CREDS_DIR/'!${NC}" >&2
        echo -e "${BRED}    Warning: Proceeding with unseal using in-memory keys.      ${NC}" >&2
        echo -e "${BRED}      THE KEYS WILL BE LOST IF YOU CLOSE THIS TERMINAL.        ${NC}" >&2
        echo -e "${BRED}         PLEASE MANUALLY SAVE THE KEYS PRINTED BELOW.          ${NC}" >&2
        echo -e "${BRED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}" >&2
        echo ""
        echo "  Initial Root Token: $VAULT_TOKEN"
        echo ""
        echo "  Unseal Keys (${#UNSEAL_KEYS[@]}):"
        for i in "${!UNSEAL_KEYS[@]}"; do
            echo "    Key $((i+1)): ${UNSEAL_KEYS[$i]}"
        done
        echo ""
        # Do not exit, allow the script to continue.
    fi
fi

# 4. Unseal all Vault units.
echo -e "${BCYAN}-> 4.${NC} Unsealing all ${#UNIT_ADDRESSES[@]} Vault units (requires ${BGREEN}$KEY_THRESHOLD${NC} keys each)..."
echo ""

# Initialize success counter.
successful_unseals=0

# 4.1. Unseal Leader Unit first.
echo "  Unsealing leader unit '$LEADER_UNIT_NAME' first..."

if unseal_unit "$LEADER_UNIT_NAME" "$LEADER_PUBLIC_ADDR"; then
    # Increment counter on success.
    successful_unseals=$((successful_unseals + 1))
else
    echo -e "${BRED}Error:${NC} Failed to unseal leader unit. Aborting." >&2
    exit 1
fi
echo ""

# 4.2. Unseal Follower Units.
echo "  Unsealing all follower units..."

for unit_name in "${!UNIT_ADDRESSES[@]}"; do
    # Skip the leader, it's already done.
    if [ "$unit_name" == "$LEADER_UNIT_NAME" ]; then
        continue
    fi

    if unseal_unit "$unit_name" "${UNIT_ADDRESSES[$unit_name]}"; then
        # Increment counter on success.
        successful_unseals=$((successful_unseals + 1))
    else
        echo -e "  ${BYELLOW}Warning:${NC} Failed to unseal follower '$unit_name'. Continuing to next unit." >&2
    fi
done

# Final summary check.
echo -e "${BCYAN}---${NC}"
total_units=${#UNIT_ADDRESSES[@]}
if [ "$successful_unseals" -eq "$total_units" ]; then
    echo -e "  ${BGREEN}Success: All $total_units units are unsealed.${NC}"
    echo ""
else
    echo -e "  ${BYELLOW}Warning: Only $successful_unseals out of $total_units units were successfully unsealed.${NC}"
    echo ""
fi

# Skip steps 5 to 8 if charm is already authorized.
if [ "$CHARM_ALREADY_AUTHORIZED" == "false" ]; then

    # 5. Pass Root Token to Juju.
    echo -e "${BCYAN}-> 5.${NC} Passing Root Token to Juju as 'one-time-token'"
    echo ""

    # Pass the token and capture the full secret ID.
    VAULT_SECRET_ID=$(juju add-secret one-time-token token="$VAULT_TOKEN")

    # Check that the command succeeded and returned a valid ID.
    if ! [[ "$VAULT_SECRET_ID" == secret:* ]]; then
        echo -e "${BRED}Error:${NC} Failed to create Juju secret. Output was: $VAULT_SECRET_ID" >&2
        exit 1
    fi
    echo "  Created Juju secret: $VAULT_SECRET_ID"
    echo ""

    echo -e "${BCYAN}-> 6.${NC} Granting secret to '$CHARM_NAME'"
    echo ""
    # Grant secret to the charm-name charm.
    juju grant-secret one-time-token "$CHARM_NAME"

    echo -e "${BCYAN}-> 7.${NC} Running 'authorize-charm' action on charm leader ($LEADER_UNIT_NAME)"
    echo ""
    authorized_success=false
    juju_exit_code=0

    if [ "$LEGACY_VAULT" == "true" ]; then
        # Run the action, tee-ing the output to the terminal (tty) and also capturing it to a variable for parsing.
        auth_output=$(juju $JUJU_RUN --wait="${TIMEOUT_MINUTES}m" "$LEADER_UNIT_NAME" authorize-charm token="$VAULT_TOKEN" 2>&1 | tee /dev/tty || juju_exit_code=$?)
    else
        # Run the action, tee-ing the output to the terminal (tty) and also capturing it to a variable for parsing.
        auth_output=$(juju $JUJU_RUN --wait="${TIMEOUT_MINUTES}m" "$LEADER_UNIT_NAME" authorize-charm secret-id="${VAULT_SECRET_ID#secret:}" 2>&1 | tee /dev/tty || juju_exit_code=$?)
    fi
   
    # Check for a "failed" message first (case-insensitive)
    if grep -q -i "failed" <<< "$auth_output"; then
        echo -e "${BRED}Error:${NC} 'authorize-charm' action failed (detected from output)." >&2
        echo ""
        authorized_success=false

    # Check for a "completed" message (case-insensitive)
    elif grep -q -i "Charm authorized" <<< "$auth_output"; then
        echo -e "  Authorization ${BGREEN}completed${NC} successfully."
        echo ""
        authorized_success=true
    
    # Fallback: If we couldn't find "failed" or "completed", trust the exit code.
    elif [ "$juju_exit_code" -eq 0 ]; then
        echo -e "  Authorization ${BGREEN}completed${NC} successfully. (based on exit code)."
        echo ""
        authorized_success=true
    
    else
        echo -e "${BRED}Error:${NC} 'authorize-charm' action failed (based on exit code $juju_exit_code)." >&2
        echo ""
        authorized_success=false
    fi

    echo -e "${BCYAN}-> 8.${NC} Cleaning up one-time Juju secret"
    echo ""
    # Remove the secret.
    juju remove-secret "$VAULT_SECRET_ID"

else
    echo -e "${BCYAN}-> 5-8.${NC} Charm is already ${BGREEN}authorized${NC}. Skipping token authorization steps."
    echo ""
    # Set to true so the final report is accurate
    authorized_success=true
fi

# Legacy mode only, generate vault root ca
if [ "$LEGACY_VAULT" == "true" ]; then
    echo -e "${BCYAN}-> 9.${NC} Legacy Vault detected. Running 'generate-root-ca' on charm leader ($LEADER_UNIT_NAME)"
    echo ""
    ca_success=false
    juju_exit_code=0
    
    # Run the action, tee-ing the output to the terminal (tty) and also capturing it to a variable for parsing.
    ca_output=$(juju $JUJU_RUN --wait="${TIMEOUT_MINUTES}m" "$LEADER_UNIT_NAME" generate-root-ca 2>&1 | tee /dev/tty || juju_exit_code=$?)
 
    # Check for a "already configured" message first (case-insensitive)
    if grep -q -i "already configured" <<< "$ca_output"; then
        echo -e "  Root CA is already ${BGREEN}configured${NC}."
        echo ""
        ca_success=true

    # Check for a "failed" message (case-insensitive)
    elif grep -q -i "failed" <<< "$ca_output"; then
        echo -e "${BRED}Error:${NC} 'generate-root-ca' action failed (detected from output)." >&2
        echo ""
        ca_success=false

    # Check for a "completed" message (case-insensitive)
    elif grep -q -i "completed" <<< "$ca_output"; then
        echo -e "  Root CA generation ${BGREEN}completed${NC} successfully."
        echo ""
        ca_success=true
        
    # Fallback: If we couldn't find "failed" or "completed", trust the exit code.
    elif [ "$juju_exit_code" -eq 0 ]; then
        echo -e "  Root CA generation ${BGREEN}completed${NC} successfully. (based on exit code)."
        echo ""
        ca_success=true

    else
        echo -e "${BRED}Error:${NC} 'generate-root-ca' action failed (based on exit code $juju_exit_code)." >&2
        echo ""
        ca_success=false
    fi
fi

# Check if cute seal was invoked (--seal).
if [ "$successful_unseals" -eq "${#UNIT_ADDRESSES[@]}" ] && [ "$authorized_success" == "true" ] && [ "$SEAL" == "true" ]; then
    seal
fi

# Final summary report.
echo "===================================================="
if [ "$successful_unseals" -eq "${#UNIT_ADDRESSES[@]}" ]; then
    echo -e "Unsealed Units:         ${BGREEN}✔ ${successful_unseals}/${#UNIT_ADDRESSES[@]}${NC}"
else
    echo -e "Unsealed Units:         ${BYELLOW}✖ ${successful_unseals}/${#UNIT_ADDRESSES[@]}${NC}"
fi

if [ "$authorized_success" == "true" ]; then
    echo -e "Charm Authorization:    ${BGREEN}✔ Success${NC}"
else
    echo -e "Charm Authorization:    ${BRED}✖ Failed${NC}"
fi

if [ "$LEGACY_VAULT" == "true" ]; then
    if [ "$ca_success" == "true" ]; then
        echo -e "Root CA Generation:     ${BGREEN}✔ Success${NC}"
    else
        echo -e "Root CA Generation:     ${BRED}✖ Failed${NC}"
    fi
fi
echo "===================================================="
if [ "$successful_unseals" -eq "${#UNIT_ADDRESSES[@]}" ] && [ "$authorized_success" == "true" ]; then
    echo -e "${BGREEN}✔ Success: All units unsealed and Charm authorized.${NC}"
else
    echo -e "${BRED}✖ Failed: Operation incomplete.${NC}"
fi
echo ""
