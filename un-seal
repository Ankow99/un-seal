#!/bin/bash

# ---
# un-seal: A helper script to initialize or unseal a Juju-deployed Vault charm.
# version: 5.4.0
#
# This script automatically finds the Juju leader unit for the Vault
# charm.
#
# 1. If Vault is *not* initialized:
#    - Runs 'vault operator init'.
#    - Prompts for a GPG ID (--gpg-id) if not provided and validates it using gpg --list-keys.
#    - Saves the new keys and root token to separate GPG-encrypted files in a specified directory. (defaults to $REAL_HOME/${MODEL_NAME}_creds/)
#    - Uses these new keys to unseal all units.
#
# 2. If Vault is *already* initialized:
#    - Tries to auto-load credentials from --creds-dir. (defaults to $REAL_HOME/${MODEL_NAME}_creds/).
#    - If auto-load fails, prompts the user for the file path to the token and each required unseal key.
#    - Prompts for YubiKey/GPG validation (PIN/touch) to decrypt the files.
#    - Uses the decrypted keys to unseal all units.
#
# Finally, it passes the root token to the charm via 'authorize-charm'
# on the leader unit.
#
# Made by: Pablo Gonzalez De Greiff @ Canonical
# ---

# Exit immediately if a command exits with a non-zero status.
# Treat unset variables as an error.
# The return value of a pipeline is the status of the last command to exit with a
# non-zero status, or zero if no command exited with a non-zero status.
set -euo pipefail

# --- Configuration ---
SNAP_VERSION=${SNAP_VERSION:-"5.4.0-script"}

CHARM_NAME="vault" # Default Juju charm name
KEY_SHARES=3 # Default keys generated
KEY_THRESHOLD=2 # Default amount of keys required to unseal vault
CREDS_DIR="" # Path to encrypted credentials directory (defaults to $REAL_HOME/${MODEL_NAME}_creds/)
GPG_ID="" # GPG Recipient ID for encryption
SKIP_AUTH=false # Force skip authorization steps
SEAL=false # Default: Do not invoke cute seal at the end

TIMEOUT_MINUTES=10 # Default timeout for unit initialization (min)
INIT_WAIT_SLEEP=30 # 30 second poll interval

JUJU="" # Holds correct juju binary path
JUJU_RUN="" # Will be set to 'juju run' or 'juju run-action' based on version
JUJU_EXEC="" # Will be set to 'juju exec' or 'juju run' based on version
MODEL_NAME="" # Will be populated in check_deps
LEGACY_VAULT=false # Will be determined by version check
CHARM_ALREADY_AUTHORIZED=false # Will be set to true if 'juju status' check passes
VAULT_SERVICE="snap.vault.vaultd.service" # Will be set to 'vault.service' based on legacy vault

VAULT_TOKEN="" # Saves the vault token
UNSEAL_KEYS=() # Saves the vault keys
VAULT_ADDR="" # Exported for vault CLI, changes per unit
VAULT_CAPATH="" # Exported for vault CLI, points to CA file
VAULT_CERT_FILE="" # Will be populated in check_deps

DECRYPTED_FILE_CONTENT="" # Global var for decrypt_file to use

# Check if running inside a snap and fix home path.
if [ -n "${SNAP:-}" ]; then
    REAL_HOME="/home/$USER"
else
    REAL_HOME="$HOME"
fi

# --- Colors ---
# Check if stderr is a TTY
if [ -t 2 ]; then
    BRED='\033[1;31m' # Bold Red
    BYELLOW='\033[1;33m' # Bold Yellow
    BGREEN='\033[1;32m' # Bold Green
    BCYAN='\033[1;36m' # Bold Cyan
    NC='\033[0m' # No Color
else
    BRED=''
    BYELLOW=''
    BGREEN=''
    BCYAN=''
    NC=''
fi

