# Function to display help message
show_help() {
    #seal
    cat << EOF
Usage: $(basename "$0") [options]
Version: $SNAP_VERSION

Initializes or unseals the Juju-deployed Vault charm using GPG/YubiKey.
This script is interactive. If Vault is already initialized, it will
prompt for YubiKey validation to decrypt the existing credentials file.

This script finds the charm leader, initializes it, fetches the CA,
unseals every unit in the charm, and then passes the root token back
to the charm on the leader via 'authorize-charm'.

Options:
  -a, --charm-name <name>   (Optional) The name of the Juju Vault charm.
                            (default: "vault") Must exist in your Juju model.
  -s, --key-shares <num>    (Optional) The number of key shares to generate.
                            (default: 3) Must be >= 1
  -t, --key-threshold <num> (Optional) The number of keys required to unseal.
                            (default: 2) Must be >= 1 and <= key-shares
  -T, --timeout <mins>      (Optional) The timeout in minutes to wait for units to initialize.
                            (default: 10) Must be >= 1
  -c, --creds-file <path>   (Optional) Path to the GPG-encrypted credentials file.
                            (default: $HOME/[charm-name]_creds.gpg)
  -g, --gpg-id <id>         (Optional) The GPG Key ID or email to use for encryption.
                            (will be prompted for on init if not provided)
  -S, --seal                (Easter Egg) Invoke cute Seal after success.
  -h, --help                Show this help message.

Example:
  # Initialize 'vault-ha' charm, specifying all parameters
  $(basename "$0") --charm-name vault-ha -s 3 -t 2 --creds-file ./vault-ha-creds.gpg --gpg-id "my-email@example.com"

  # Initialize 'vault' charm, using defaults (will prompt for GPG ID)
  $(basename "$0")

  # Unseal 'vault' charm using the default credentials file location with 5 shares, requiring 3 to unseal
  $(basename "$0") -s 5 -t 3
EOF
}

# Securely overwrite and remove a file.
secure_delete() {
    local file="$1"
    if [ -f "$file" ]; then
        # Check if shred is available
        if command -v shred >/dev/null 2>&1; then
            shred -u -z -n 1 "$file"
            echo "Temporary file '$file' shredded."
        else
            # Fallback to rm if shred is missing
            rm -f "$file"
            echo "Temporary file '$file' deleted."
        fi
    fi
}

# Cleanup function to remove temporary files on EXIT.
cleanup() {
    if [ -n "${VAULT_CERT_FILE:-}" ] && [ -f "$VAULT_CERT_FILE" ]; then
        secure_delete "$VAULT_CERT_FILE"
    fi
}

# Function to check script parameters for validity.
check_params() {
    local int_regex='^[0-9]+$'
    local error_found=0

    # 1. Check CHARM_NAME.
    if [ -z "$CHARM_NAME" ]; then
        echo -e "${RED}Error:${NC} charm name (--charm-name) cannot be empty." >&2
        error_found=1
    fi

    # 2. Check KEY_SHARES.
    if ! [[ "$KEY_SHARES" =~ $int_regex ]] || [ "$KEY_SHARES" -lt 1 ]; then
        echo -e "${RED}Error:${NC} Key shares (--key-shares) must be an integer >= 1. (Got: '$KEY_SHARES')" >&2
        error_found=1
    fi

    # 3. Check KEY_THRESHOLD.
    if ! [[ "$KEY_THRESHOLD" =~ $int_regex ]] || [ "$KEY_THRESHOLD" -lt 1 ]; then
        echo -e "${RED}Error:${NC} Key threshold (--key-threshold) must be an integer >= 1. (Got: '$KEY_THRESHOLD')" >&2
        error_found=1
    fi

    # 4. Check relationship between SHARES and THRESHOLD.
    # Only check this if both values were valid integers.
    if [[ "$KEY_SHARES" =~ $int_regex ]] && [[ "$KEY_THRESHOLD" =~ $int_regex ]]; then
        if [ "$KEY_THRESHOLD" -gt "$KEY_SHARES" ]; then
            echo -e "${RED}Error:${NC} Key threshold ($KEY_THRESHOLD) cannot be greater than key shares ($KEY_SHARES)." >&2
            error_found=1
        fi
    fi

    # 5. Check TIMEOUT_MINUTES.
    if ! [[ "$TIMEOUT_MINUTES" =~ $int_regex ]] || [ "$TIMEOUT_MINUTES" -lt 1 ]; then
        echo -e "${RED}Error:${NC} Timeout (--timeout) must be an integer in minutes >= 1. (Got: '$TIMEOUT_MINUTES')" >&2
        error_found=1
    fi
    
    if [ "$error_found" -eq 1 ]; then
        echo ""
        show_help
        exit 1
    fi
}

# Function to check for required command-line tools.
check_deps() {
    local missing_deps=0
    
    echo "  Checking dependencies..."

    if ! juju --version > /dev/null 2>&1; then
        echo -e "${RED}Error:${NC} 'juju' command not found or not functional." >&2
        missing_deps=1
    fi
    
    if ! jq --version > /dev/null 2>&1; then
        echo -e "${RED}Error:${NC} 'jq' command not found or not functional (check for library errors)." >&2
        missing_deps=1
    fi
    
    if ! vault -version > /dev/null 2>&1; then
        echo -e "${RED}Error:${NC} 'vault' command not found or not functional." >&2
        missing_deps=1
    fi

    if ! gpg --version > /dev/null 2>&1; then
        echo -e "${RED}Error:${NC} 'gpg' command not found or not functional." >&2
        echo "       'gpg' is required for YubiKey encryption/decryption." >&2
        missing_deps=1
    fi

    if [ "$missing_deps" -eq 1 ]; then
        exit 1
    fi
    echo "  All dependencies found."

    # Verify the charm name exists in the current Juju model.
    echo "  Verifying Juju charm '$CHARM_NAME' exists..."

    if ! juju status --format=json | jq -e --arg charm "$CHARM_NAME" '.applications | has($charm)' > /dev/null 2>&1; then
        echo -e "${RED}Error:${NC} Juju charm '$CHARM_NAME' not found in the current model." >&2
        echo "       Please check the charm name and your current Juju model." >&2
        exit 1
    fi

    echo "  charm found."
    echo ""
}

# Saves the 'vault operator init' JSON output to a GPG-encrypted file.
# Arguments:
#   $1: The JSON data string from 'vault operator init'
# Returns: 0 on success, 1 on failure
save_credentials_gpg() {
    local json_data="$1"
    
    echo "  Saving new credentials to GPG-encrypted file: $CREDS_FILE"

    # Encrypt the JSON data and save to file
    if ! gpg --quiet --yes -e -r "$GPG_ID" -o "$CREDS_FILE" <<< "$json_data"; then
        echo -e "${RED}Error:${NC} Failed to encrypt credentials with GPG." >&2
        echo "       Check if the GPG ID '$GPG_ID' is valid and your gpg-agent is running." >&2
        return 1
    fi

    # Set permissions so only the user can read/write it.
    chmod 600 "$CREDS_FILE"
    
    echo -e "${CYAN}---${NC}"
    echo -e "  ${GREEN}IMPORTANT:${NC}"
    echo -e "  New credentials have been ${GREEN}GPG-ENCRYPTED${NC} and saved to $CREDS_FILE"
    echo "  Please back up this file immediately."
    echo -e "${CYAN}---${NC}"
    echo ""
    return 0
}

# Loads and decrypts the credentials file using GPG (and YubiKey).
# This function populates the global UNSEAL_KEYS array and VAULT_TOKEN var
# Returns: 0 on success, 1 on failure
load_credentials_gpg() {
    echo "  Loading credentials from GPG-encrypted file: $CREDS_FILE"
    
    if [ ! -f "$CREDS_FILE" ]; then
        echo -e "${RED}Error:${NC} Credentials file not found at $CREDS_FILE" >&2
        return 1
    fi

    echo "  Please validate with your GPG key (YubiKey PIN/touch may be required)..."
    
    # Decrypt the file
    local decrypted_json
    if ! decrypted_json=$(gpg -q -d "$CREDS_FILE"); then
        echo -e "${RED}Error:${NC} Failed to decrypt credentials file." >&2
        echo "       Did you enter the correct PIN? Is the YubiKey plugged in?" >&2
        return 1
    fi

    # Check if decrypted content is valid JSON
    if ! jq -e . > /dev/null 2>&1 <<< "$decrypted_json"; then
        echo -e "${RED}Error:${NC} Decrypted content is not valid JSON." >&2
        echo "       Is $CREDS_FILE the correct credentials file?" >&2
        return 1
    fi

    # Populate global variables
    VAULT_TOKEN=$(jq -r '.root_token' <<< "$decrypted_json")
    readarray -t UNSEAL_KEYS < <(jq -r '.unseal_keys_b64[]' <<< "$decrypted_json")

    if [ -z "$VAULT_TOKEN" ] || [ ${#UNSEAL_KEYS[@]} -eq 0 ]; then
        echo -e "${RED}Error:${NC} Failed to parse root token or unseal keys from $CREDS_FILE." >&2
        return 1
    fi

    echo ""
    echo -e "  ${GREEN}Credentials successfully decrypted and loaded.${NC}"
    echo ""
    return 0
}

# Function to handle all unseal logic - unseal_unit(unit_name, unit_addr)
# Returns 0 on success, 1 on failure
unseal_unit() {
    local unit_name="$1"
    local unit_addr="$2"
    local status_json=""
    local unseal_status=""
    local verify_status=""
    local initialized=false
    local unsealed=false

    export VAULT_ADDR="https://$unit_addr:8200"
    echo -e "${CYAN}---${NC}"
    echo "  Targeting unit '$unit_name' at $VAULT_ADDR"

    # 1. Wait for the unit to be initialized.
    echo "    Waiting for unit to report as initialized..."
    for (( attempt=1; attempt<=$MAX_INIT_WAIT_ATTEMPTS; attempt++ )); do
        status_json=$(vault status -format=json 2>/dev/null || true)
        if [ -n "$status_json" ] && [ "$(jq -r '.initialized' <<< "$status_json")" == "true" ]; then
            printf "\r    Unit is ${GREEN}initialized${NC}.                          \n"
            initialized=true
            break
        fi
        printf "\r    Waiting for unit to report as initialized... (attempt $attempt/$MAX_INIT_WAIT_ATTEMPTS)"
        sleep $INIT_WAIT_SLEEP
    done

    # Check if unit initialized.
    if [ "$initialized" == "false" ]; then
        printf "\n"
        echo -e "  ${YELLOW}Warning:${NC} Unit '$unit_name' did not initialize after $MAX_INIT_WAIT_ATTEMPTS attempts. Skipping." >&2
        return 1 # Failure
    fi

    # 2. Check if already unsealed.
    if [ "$(jq -r '.sealed' <<< "$status_json")" != "true" ]; then
        echo -e "    Unit '$unit_name' is already ${GREEN}unsealed${NC}. Skipping."
        return 0 # Success
    fi

    # 3. Unit is initialized but sealed, submit the correct number of keys.
    for (( i=0; i<$KEY_THRESHOLD; i++ )); do
        echo "    Submitting Unseal Key $((i+1)) to '$unit_name'..."
        unseal_status=$(vault operator unseal -format=json "${UNSEAL_KEYS[$i]}")
        
        # Check for errors.
        if ! jq -e . > /dev/null 2>&1 <<< "$unseal_status"; then
            echo -e "  ${YELLOW}Warning:${NC} 'vault operator unseal' failed. Output was not valid JSON." >&2
            echo "           This could mean the key you entered was incorrect." >&2
            echo "Raw output: $unseal_status" >&2
            return 1 # Failure
        fi
        
        # Check if unsealed. If we get it, break early.
        if jq -r '.sealed' <<< "$unseal_status" | grep -q 'false'; then
            break
        fi

        # Print progress if it's not the final key.
        progress=$(jq -r '.progress' <<< "$unseal_status")
        total=$(jq -r '.t' <<< "$unseal_status")
        if [[ "$progress" != "null" ]] && [[ "$total" != "null" ]] && [[ "$progress" -gt 0 ]]; then
            echo "    Progress: $progress / $total"
        fi
    done

    # 4. Verify the unseal.
    echo "    Verifying unseal status..."
    for (( attempt=1; attempt<=$MAX_INIT_WAIT_ATTEMPTS; attempt++ )); do
        verify_status=$(vault status -format=json 2>/dev/null || true)
        if jq -r '.sealed' <<< "$verify_status" | grep -q 'false'; then
            printf "\r    Unit '$unit_name' is now ${GREEN}unsealed.${NC}          \n"
            unsealed=true
            break
        fi
        printf "\r    Verifying unseal status... (attempt $attempt/$MAX_INIT_WAIT_ATTEMPTS)"
        sleep 3
    done
    
    # Failure.
    if [ "$unsealed" == "false" ]; then
        printf "\n"
        echo -e "  ${YELLOW}Warning:${NC} Failed to verify unseal for unit '$unit_name' after submitting keys." >&2
        echo "           Please check the unit's logs." >&2
        return 1 # Failure.
    fi
    
    return 0 # Success.
}

# --- Argument Parsing ---

while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--charm-name)
            CHARM_NAME="$2"
            shift 2
            ;;
        -s|--key-shares)
            KEY_SHARES="$2"
            shift 2
            ;;
        -t|--key-threshold)
            KEY_THRESHOLD="$2"
            shift 2
            ;;
        -T|--timeout)
            TIMEOUT_MINUTES="$2"
            shift 2
            ;;
        -c|--creds-file)
            CREDS_FILE="$2"
            shift 2
            ;;
        -g|--gpg-id)
            GPG_ID="$2"
            shift 2
            ;;
        -S|--seal)
            SEAL=true
            shift 1
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -*)
            echo -e "${RED}Error:${NC} Unknown option: $1" >&2
            show_help
            exit 1
            ;;
        *)
            echo -e "${RED}Error:${NC} This script does not accept positional arguments." >&2
            show_help
            exit 1
            ;;
    esac
done

# --- Main Script Logic ---

echo ""
echo -e "${CYAN}-> un-seal version: $SNAP_VERSION${NC}"
echo ""

# Validate parameters *before* doing anything else.
check_params

# Check dependencies.
check_deps

# Set up trap for file cleanup.
trap cleanup EXIT

# Set default CREDS_FILE if not provided.
if [ -z "$CREDS_FILE" ]; then
    CREDS_FILE="${HOME}/${CHARM_NAME}_creds.gpg"
    echo "  --creds-file not specified, using default: $CREDS_FILE"
fi

# Calculate polling parameters from timeout.
MAX_INIT_WAIT_ATTEMPTS=$((TIMEOUT_MINUTES * 60 / INIT_WAIT_SLEEP))
echo "  Unit initialization timeout set to $TIMEOUT_MINUTES minutes ($MAX_INIT_WAIT_ATTEMPTS checks, $INIT_WAIT_SLEEP sec interval)."

# Use a predictable file in the user's HOME directory for the CA.
VAULT_CERT_FILE="${HOME}/${CHARM_NAME}_ca.pem"

# We need an associative array to map unit names to their addresses.
# This requires Bash 4+.
if [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
    echo -e "${RED}Error:${NC} This script requires Bash 4.0 or newer." >&2
    exit 1
fi
declare -A UNIT_ADDRESSES

echo ""
echo "  Starting un-seal process for Juju charm: $CHARM_NAME"
echo "  Shares:       $KEY_SHARES"
echo "  Threshold:    $KEY_THRESHOLD"
echo "  Creds File:   $CREDS_FILE"
[ -n "$GPG_ID" ] && echo "  GPG ID:       $GPG_ID (will be used for init)"
echo ""

# 1. Find Vault units and leader.
echo -e "${CYAN}-> 1.${NC} Finding Vault units and leader for charm '$CHARM_NAME'..."
VAULT_STATUS_JSON=$(juju status --format=json)
LEADER_UNIT_NAME=""

echo ""
echo "  Parsing unit information..."
while IFS=" " read -r unit_name public_address is_leader; do
    if [ -n "$unit_name" ] && [ -n "$public_address" ] && [ "$public_address" != "null" ]; then
        UNIT_ADDRESSES["$unit_name"]="$public_address"
        if [ "$is_leader" == "true" ]; then
            LEADER_UNIT_NAME="$unit_name"
        fi
    fi
done < <(jq -r --arg charm "$CHARM_NAME" '.applications[$charm].units | to_entries[] | "\(.key) \(.value."public-address") \(.value.leader)"' <<< "$VAULT_STATUS_JSON")

if [ ${#UNIT_ADDRESSES[@]} -eq 0 ]; then
    echo -e "${RED}Error:${NC} Found no units with public addresses for charm '$CHARM_NAME'." >&2
    exit 1
fi
echo "  Found ${#UNIT_ADDRESSES[@]} unit(s): ${!UNIT_ADDRESSES[*]}"

if [ -z "$LEADER_UNIT_NAME" ]; then
    echo -e "${RED}Error:${NC} Could not find leader unit for charm '$CHARM_NAME'." >&2
    echo "       Is the charm name correct and has it settled?" >&2
    exit 1
fi
echo "  Juju '$CHARM_NAME' leader unit is: $LEADER_UNIT_NAME"

# Set VAULT_ADDR to the leader's address for initialization.
LEADER_PUBLIC_ADDR=${UNIT_ADDRESSES["$LEADER_UNIT_NAME"]}
if [ -z "$LEADER_PUBLIC_ADDR" ]; then
    echo -e "${RED}Error:${NC} Could not find public-address for leader unit '$LEADER_UNIT_NAME'." >&2
    exit 1
fi

export VAULT_ADDR="https://$LEADER_PUBLIC_ADDR:8200"
echo "  Leader VAULT_ADDR set to: $VAULT_ADDR (for init)"
echo ""

# 2. Fetch Juju secret for Vault CA certificate.
echo -e "${CYAN}-> 2.${NC} Fetching Vault CA certificate..."
echo ""
CERT_SECRET_ID=$(juju secrets --format=json | jq -r 'to_entries[] | select(.value.label == "self-signed-vault-ca-certificate") | .key')

if [ -z "$CERT_SECRET_ID" ] || [ "$CERT_SECRET_ID" == "null" ]; then
    echo -e "${RED}Error:${NC} Could not find Juju secret with label 'self-signed-vault-ca-certificate'." >&2
    exit 1
fi

juju show-secret "$CERT_SECRET_ID" --reveal --format=json | jq -r '.[].content.Data.certificate' > "$VAULT_CERT_FILE"
echo "  Created temporary CA file: $VAULT_CERT_FILE"

export VAULT_CAPATH="$VAULT_CERT_FILE"
echo "  VAULT_CAPATH set to temporary file: $VAULT_CAPATH"
echo ""

# 3. Initialize Vault.
echo -e "${CYAN}-> 3.${NC} Initializing Vault (targeting leader $LEADER_UNIT_NAME)..."
# We use -format=json for reliable parsing.
init_output_and_errors=$(vault operator init -key-shares="$KEY_SHARES" -key-threshold="$KEY_THRESHOLD" -format=json 2>&1 || true)

# Declare keys and token vars.
UNSEAL_KEYS=()
VAULT_TOKEN=""

# First, check for the specific "already initialized" error.
if grep -q "Vault is already initialized" <<< "$init_output_and_errors"; then
    echo ""
    echo "  Vault is already initialized. Loading credentials from encrypted file."
    
    # Load credentials from GPG file. This will prompt for YubiKey.
    if ! load_credentials_gpg; then
        echo -e "${RED}Error:${NC} Could not load credentials." >&2
        exit 1
    fi

    # Get the required threshold from status to inform the user.
    status_json=$(vault status -format=json 2>/dev/null || true)

    # Check loaded keys against actual threshold.
    actual_threshold=$(jq -r '.t' <<< "$status_json")
    
    if ! [[ "$actual_threshold" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}Error:${NC} Could not determine actual key threshold from 'vault status'." >&2
        exit 1
    fi
    
    echo "  Vault status shows a key threshold of $actual_threshold."
    echo "  Loaded ${#UNSEAL_KEYS[@]} keys and 1 root token from $CREDS_FILE."

    if [ ${#UNSEAL_KEYS[@]} -lt "$actual_threshold" ]; then
        echo -e "${RED}Error:${NC} The credentials file ($CREDS_FILE) only contains ${#UNSEAL_KEYS[@]} keys," >&2
        echo "       but Vault requires an unseal threshold of $actual_threshold." >&2
        echo "       Please provide a valid credentials file." >&2
        exit 1
    fi

    # This ensures unseal_unit submits the correct number of keys.
    KEY_THRESHOLD=$actual_threshold
    echo "  Key threshold for unseal operation set to $KEY_THRESHOLD."
    echo ""

else
    # Vault is NOT initialized. Check for other errors.
    # We redirect jq's stderr to /dev/null to silence "parse error" messages.
    init_output=$(jq -e . 2> /dev/null <<< "$init_output_and_errors")

    if [ -z "$init_output" ]; then
        # It failed JSON parsing *and* wasn't the "already initialized" error.
        echo -e "${RED}Error:${NC} 'vault operator init' failed. Output was not valid JSON." >&2
        echo "Raw output:" >&2
        echo "$init_output_and_errors" >&2
        exit 1
    fi

    echo ""
    echo -e "  ${GREEN}Vault Initialized Successfully.${NC}"
    
    # Parse JSON output.
    UNSEAL_KEYS=($(jq -r '.unseal_keys_b64[]' <<< "$init_output"))
    VAULT_TOKEN=$(jq -r '.root_token' <<< "$init_output")

    # Prompt for GPG_ID if not provided.
    if [ -z "$GPG_ID" ]; then
        echo "  Vault is newly initialized, but no GPG ID was provided."
        echo ""
        while [ -z "$GPG_ID" ]; do
            read -p "  Please enter the GPG Key ID or email for encryption: " GPG_ID >&2
        done
        echo ""
    fi
    
    if ! save_credentials_gpg "$init_output"; then
        echo ""
        echo -e "${RED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}" >&2
        echo -e "${RED}  Error: Could not save encrypted credentials to '$CREDS_FILE'!${NC}" >&2
        echo -e "${RED}    Warning: Proceeding with unseal using in-memory keys.      ${NC}" >&2
        echo -e "${RED}      THE KEYS WILL BE LOST IF YOU CLOSE THIS TERMINAL.        ${NC}" >&2
        echo -e "${RED}         PLEASE MANUALLY SAVE THE KEYS PRINTED BELOW.          ${NC}" >&2
        echo -e "${RED}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${NC}" >&2
        echo ""
        echo "  Initial Root Token: $VAULT_TOKEN"
        echo ""
        echo "  Unseal Keys (${#UNSEAL_KEYS[@]}):"
        for i in "${!UNSEAL_KEYS[@]}"; do
            echo "    Key $((i+1)): ${UNSEAL_KEYS[$i]}"
        done
        echo ""
        # Do not exit, allow the script to continue.
    fi
fi

# 4. Unseal all Vault units.
echo -e "${CYAN}-> 4.${NC} Unsealing all ${#UNIT_ADDRESSES[@]} Vault units (requires $KEY_THRESHOLD keys each)..."
echo ""

# Initialize success counter.
successful_unseals=0

# 4.1. Unseal Leader Unit first.
echo "  Unsealing leader unit '$LEADER_UNIT_NAME' first..."
if unseal_unit "$LEADER_UNIT_NAME" "$LEADER_PUBLIC_ADDR"; then
    # Increment counter on success.
    successful_unseals=$((successful_unseals + 1))
else
    echo -e "${RED}Error:${NC} Failed to unseal leader unit. Aborting." >&2
    exit 1
fi

# 4.2. Unseal Follower Units.
echo ""
echo "  Unsealing all follower units..."

for unit_name in "${!UNIT_ADDRESSES[@]}"; do
    # Skip the leader, it's already done.
    if [ "$unit_name" == "$LEADER_UNIT_NAME" ]; then
        continue
    fi

    if unseal_unit "$unit_name" "${UNIT_ADDRESSES[$unit_name]}"; then
        # Increment counter on success.
        successful_unseals=$((successful_unseals + 1))
    else
        echo -e "  ${YELLOW}Warning:${NC} Failed to unseal follower '$unit_name'. Continuing to next unit." >&2
    fi
done

# Final summary check.
echo -e "${CYAN}---${NC}"
total_units=${#UNIT_ADDRESSES[@]}
if [ "$successful_unseals" -eq "$total_units" ]; then
    echo -e "  ${GREEN}Success:${NC} All $total_units units are unsealed."
    echo ""
else
    echo -e "  ${YELLOW}Warning:${NC} $successful_unseals out of $total_units units were successfully unsealed."
    echo ""
fi

# 5. Pass Root Token to Juju.
echo -e "${CYAN}-> 5.${NC} Passing Root Token to Juju as 'one-time-token'"
echo ""

# Pass the token and capture the full secret ID.
VAULT_SECRET_ID=$(juju add-secret one-time-token token="$VAULT_TOKEN")

# Check that the command succeeded and returned a valid ID.
if ! [[ "$VAULT_SECRET_ID" == secret:* ]]; then
    echo -e "${RED}Error:${NC} Failed to create Juju secret. Output was: $VAULT_SECRET_ID" >&2
    exit 1
fi
echo "  Created Juju secret: $VAULT_SECRET_ID"
echo ""

echo -e "${CYAN}-> 6.${NC} Granting secret to '$CHARM_NAME'"
echo ""
# Grant secret to the charm-name charm.
juju grant-secret one-time-token "$CHARM_NAME"

echo -e "${CYAN}-> 7.${NC} Triggering 'authorize-charm' action on charm leader ($LEADER_UNIT_NAME)"
echo ""
authorized_success=false

# Authorize the charm to interact with Vault using the secret ID.
if juju run --wait="${TIMEOUT_MINUTES}m" "$LEADER_UNIT_NAME" authorize-charm secret-id="${VAULT_SECRET_ID#secret:}"; then
    authorized_success=true
else
    authorized_success=false
    echo -e "${RED}Error:${NC} 'authorize-charm' action failed."
fi

echo -e "${CYAN}-> 8.${NC} Cleaning up one-time Juju secret"
echo ""
# Remove the secret.
juju remove-secret "$VAULT_SECRET_ID"

# Final summary report.
if [ "$successful_unseals" -eq "${#UNIT_ADDRESSES[@]}" ]; then
    echo -e "Unsealed Units: ${GREEN}${successful_unseals}/${#UNIT_ADDRESSES[@]}${NC}"
else
    echo -e "Unsealed Units: ${YELLOW}${successful_unseals}/${#UNIT_ADDRESSES[@]}${NC}"
fi

if [ "$authorized_success" == "true" ]; then
    echo -e "Charm Authorization: ${GREEN}Success${NC}"
else
    echo -e "Charm Authorization: ${RED}Failed${NC}"
fi

if [ "$successful_unseals" -eq "${#UNIT_ADDRESSES[@]}" ] && [ "$authorized_success" == "true" ]; then
    # Check if cute seal was invoked.
    if [ "$SEAL" == "true" ]; then
        seal
    fi
    echo -e "${GREEN}✔ Success: All units unsealed and Charm authorized.${NC}"
    echo ""
    # Shred credential file since all units were unsealed and the charm was authorized.
    secure_delete "$CREDS_FILE"
else
    echo -e "${RED}✖ Failed: Operation incomplete.${NC}"
    echo ""
fi
